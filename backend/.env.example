# ============================================================
# DeepGuard Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ── Application ─────────────────────────────────────────────
APP_NAME=DeepGuard
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development

# ── MongoDB ─────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=deepguard

# ── JWT ─────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_STRING_AT_LEAST_64_CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# ── OTP ─────────────────────────────────────────────────────
OTP_EXPIRATION_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_DEV_MODE=true   # Set to false in production to use real email

# ── SMTP / Email ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@deepguard.ai
SMTP_USE_TLS=true

# ── File Storage ─────────────────────────────────────────────
STORAGE_TYPE=local
STORAGE_PATH=./storage/uploads
MAX_UPLOAD_SIZE_MB=10

# ── S3 (optional — leave blank for local dev) ───────────────
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT_URL=

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_PER_DAY=500

# ── ML Models ─────────────────────────────────────────────────
# Path to the directory containing the 5 trained .h5 model files
MODEL_DIRECTORY=../../model_train
MODEL_INPUT_SIZE=224
MODEL_VERSION=v1

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Redis (optional — for distributed rate limiting) ─────────
REDIS_URL=

# ── Admin ─────────────────────────────────────────────────────
ADMIN_EMAIL=

# ── Cleanup ──────────────────────────────────────────────────
CLEANUP_INTERVAL_HOURS=6
